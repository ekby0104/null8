{
  "name": "null8",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy:mediapipe": "node -e \"require('fs').cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe/wasm',{recursive:true})\"",
    "predev": "npm run copy:mediapipe",
    "prebuild": "npm run copy:mediapipe",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  }
}
